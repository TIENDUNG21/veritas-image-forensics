{
  "name": "veritas-image-forensics",
  "version": "1.0.0",
  "description": "Image forensics in your browser. Find what was edited.",
  "private": true,
  "license": "MIT",
  "author": "TIENDUNG21",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --port 5190 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 5191 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "check:dist": "node tools/check-dist.mjs",
    "samples": "node tools/make-samples.mjs",
    "bench": "node tools/bench.mjs",
    "evaluate": "node tools/evaluate.mjs",
    "screenshot": "node tools/screenshot.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "jpeg-js": "0.4.4",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
